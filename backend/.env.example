# =============================================================================
# Riad Atlas — Hotel Management System
# Exemple de configuration — Copier ce fichier en .env et remplir les valeurs
# NE JAMAIS commiter le fichier .env réel dans Git
# =============================================================================

# Django
DJANGO_SECRET_KEY=remplace-par-une-cle-longue-et-aleatoire
DJANGO_DEBUG=True

# Base de données MySQL
# Port 3307 utilisé par défaut dans ce projet (non standard)
# Si ton MySQL écoute sur 3306, changer DB_PORT=3306
DB_NAME=hotel_management
DB_USER=root
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=3307
